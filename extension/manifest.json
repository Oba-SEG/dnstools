{
  "manifest_version": 3,
  "name": "Nexus DNS Lookup",
  "version": "1.0.0",
  "description": "Instant DNS record checks for any domain via the free Nexus Domain Tools API.",
  "permissions": ["contextMenus", "activeTab"],
  "host_permissions": ["https://ndns-api.onrender.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nexus DNS Lookup"
  },
  "background": {
    "service_worker": "background.js"
  }
}
